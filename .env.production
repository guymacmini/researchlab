# Production Environment Configuration for ResearchLab
# Copy this file to .env.production and update with your values
# Usage: docker-compose -f docker-compose.production.yml --env-file .env.production up -d

# ================================
# CRITICAL SECURITY SETTINGS
# ================================
# Generate a strong secret key: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_STRONG_SECRET_KEY

# Database password - use a strong password
DB_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

# ================================
# API KEYS (Required)
# ================================
# Financial data APIs
FINNHUB_API_KEY=your_finnhub_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# LLM APIs  
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ================================
# GOOGLE SERVICES (Optional)
# ================================
# Path to Google service account credentials JSON file
# Mount the file and set this path inside container
GOOGLE_CREDENTIALS_FILE=/app/credentials/google-service-account.json
GOOGLE_CREDENTIALS_PATH=./path/to/your/google-credentials.json

# ================================
# APPLICATION SETTINGS
# ================================
ENVIRONMENT=production
DEBUG=false
APP_NAME=ResearchLab
HOST=0.0.0.0
PORT=8000

# Server configuration
WORKERS=4
USE_GUNICORN=true
ACCESS_LOG=true

# CORS settings (adjust for your domain)
CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# ================================
# DATABASE SETTINGS
# ================================
DB_HOST=postgres
DB_PORT=5432  
DB_NAME=researchlab_prod
DB_USER=researchlab
# DB_PASSWORD is set above

# Connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# ================================
# REDIS SETTINGS
# ================================
REDIS_URL=redis://redis:6379/0
REDIS_TIMEOUT=5

# ================================
# MONITORING & LOGGING
# ================================
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring
METRICS_ENABLED=true
HEALTH_ENABLED=true  
ALERTS_ENABLED=true
ERROR_THRESHOLD=50
LATENCY_THRESHOLD=2000

# ================================
# SECURITY & RATE LIMITING
# ================================
RATE_LIMIT_ENABLED=true
REQUESTS_PER_MINUTE=1000
BURST_SIZE=50

# API validation
API_KEY_VALIDATION_ENABLED=true
MAX_REQUEST_SIZE=10MB

# ================================
# EXTERNAL SERVICES
# ================================
# Email notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_TLS=true

# Slack notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ================================
# OPTIONAL SERVICES
# ================================
# Grafana dashboard password
GRAFANA_PASSWORD=secure_grafana_password

# Backup settings
BACKUP_ENABLED=true
BACKUP_S3_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1

# ================================
# PERFORMANCE TUNING
# ================================
# Agent settings
MAX_CONCURRENT_AGENTS=8
AGENT_TIMEOUT_SECONDS=300

# Cache settings
CACHE_DEFAULT_TTL=3600
STOCK_DATA_TTL=300
NEWS_DATA_TTL=1800

# Workflow settings
MAX_CONCURRENT_WORKFLOWS=5
DEFAULT_TIMEOUT_MINUTES=60

# ================================
# SSL/TLS (if using nginx)
# ================================
# SSL_CERT_PATH=./docker/nginx/ssl/cert.pem
# SSL_KEY_PATH=./docker/nginx/ssl/key.pem